Flow org.gluu.agama.newregistration.phiwallet
     Basepath ""
     Timeout 3000 seconds
// Create  variable for UI feedback
uiFeedback = {}
uiFeedback.errorMessage = ""
emailObj = {}
sendMail = true
uiInput = {matches: true, resent: false}
// Iterate x times max
maxJourney = Repeat 6 times max
// Maximum attempt reached
Log "@info Maximum attempt reached"
// User Registration flow failed
it_ssvbs = {success:false, error: "User registration flow reached max attempts try later"}
Finish it_ssvbs